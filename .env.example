# 세 제공사 중 설정된 것만 사용됩니다. 최소 하나는 필요합니다.
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

# 모델 ID (선택). 제공사 문서의 현재 모델명으로 바꿀 수 있습니다.
# ANTHROPIC_MODEL=claude-opus-5-5
# GOOGLE_MODEL=gemini-flash-latest
# OPENAI_MODEL=gpt-5.5
# JUDGE_MODEL=claude-sonnet-5-5

# 서버 DB. 비우면 .data/pglite 폴더에 파일 기반 PGlite(내장 Postgres)를 씁니다.
# 운영에서는 PostgreSQL 연결 문자열을 넣으세요.
# DATABASE_URL=postgres://user:pass@localhost:5432/think_first

# API 키 없이 화면만 확인할 때 1로 설정
# MOCK_AI=1
