# 세 제공사 중 설정된 것만 사용됩니다. 최소 하나는 필요합니다.
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

# 모델 ID (선택). 기본값은 가장 가벼운 모델입니다. 품질을 올리려면 바꾸세요.
# ANTHROPIC_MODEL=claude-haiku-5-5     # 더 좋게: claude-sonnet-5-5
# GOOGLE_MODEL=gemini-flash-latest     # 더 싸게: gemini-3.1-flash-lite
# OPENAI_MODEL=gpt-5.4-nano            # 더 좋게: gpt-5.4-mini, gpt-5.5
# JUDGE_MODEL=claude-haiku-5-5         # 더 좋게: claude-sonnet-5-5

# 서버 DB. 비우면 .data/pglite 폴더에 파일 기반 PGlite(내장 Postgres)를 씁니다.
# 운영에서는 PostgreSQL 연결 문자열을 넣으세요.
# DATABASE_URL=postgres://user:pass@localhost:5432/think_first

# 인증·비밀번호 재설정 메일. 비우면 링크를 서버 콘솔(개발 모드에서는 화면에도)에 출력합니다.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="생각 먼저 AI <no-reply@example.com>"
# 메일 링크의 기준 주소. 비우면 요청 헤더(host)로 만듭니다.
# APP_URL=https://example.com

# API 키 없이 화면만 확인할 때 1로 설정
# MOCK_AI=1
